{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work360",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "work360.rising.sh", "custom_domain": true }],
  "vars": {
    "APP_PUBLIC_ORIGIN": "https://work360.rising.sh",
    "NOTIFICATION_ROUTES": "email:resend",
    "EMAIL_FROM": "work360 <no-reply@work360.rising.sh>",
    "ENGINE_HMAC_KEY_ID": "work360",
  },
  // A stores:push commit swaps a whole workspace in one transaction. The
  // 327 MB Entel store took 26 s of CPU locally, near the 30 s default.
  "limits": { "cpu_ms": 300000 },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/_server*"],
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceObject" },
      { "name": "PLATFORM", "class_name": "PlatformObject" },
      { "name": "REGISTRY", "class_name": "RegistryObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceObject",
        "PlatformObject",
        "RegistryObject",
      ],
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "work360-files" }],
}
